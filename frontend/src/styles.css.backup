:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#e7edf5;background:#080d14;font-synthesis:none}
*{box-sizing:border-box}body{margin:0}button,input,textarea,select{font:inherit}button{cursor:pointer}
.app{min-height:100vh;display:flex;background:#080d14}
aside{width:250px;border-right:1px solid #1c2734;background:#0b111a;padding:22px 14px;display:flex;flex-direction:column;position:fixed;height:100vh}
.brand{display:flex;gap:11px;align-items:center;color:#f4f7fb}.brand svg{color:#55d6be}.brand h1{margin:0;font-size:21px}.brand span{display:block;color:#8492a6;font-size:12px;margin-top:2px}.brand.side b{font-size:15px}.brand.side span{font-size:11px}
nav{margin-top:32px;display:grid;gap:6px}nav button,.side-bottom button{background:transparent;color:#8f9daf;border:0;padding:11px 12px;border-radius:9px;text-align:left;display:flex;align-items:center;gap:10px}nav button svg,.side-bottom button svg{width:17px}nav button.active,nav button:hover,.side-bottom button:hover{background:#14202d;color:#fff}
.side-bottom{margin-top:auto;display:grid;gap:5px}.live{padding:10px 12px;color:#8f9daf;font-size:12px}.dot{display:inline-block;width:8px;height:8px;background:#6b7280;border-radius:50%;margin-right:7px}.dot.on{background:#55d6be;box-shadow:0 0 10px #55d6be}
main{margin-left:250px;flex:1}header{height:88px;border-bottom:1px solid #1c2734;display:flex;justify-content:space-between;align-items:center;padding:0 32px;background:#0b111a}header h2{margin:0;font-size:23px}header p{margin:4px 0 0;color:#718096;font-size:13px}.header-right{display:flex;align-items:center;gap:15px}.pill{border:1px solid #234b48;background:#10231f;color:#55d6be;border-radius:999px;padding:6px 10px;font-size:11px}.clock{color:#69778a;font-size:12px}
.content{padding:28px 32px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.metric,.panel{background:#0e1621;border:1px solid #1c2734;border-radius:12px}.metric{padding:20px;display:flex;gap:15px;align-items:center}.metric-icon{width:42px;height:42px;display:grid;place-items:center;background:#132231;border-radius:10px;color:#55d6be}.metric span{display:block;color:#7d8a9d;font-size:12px}.metric strong{display:block;font-size:27px;margin-top:5px}.metric.danger .metric-icon{color:#ff6675}.grid-two{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.panel{padding:20px}.panel-head,.toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.panel-head h3{margin:0;font-size:15px}.panel-head span,.toolbar>span{color:#718096;font-size:12px}
.severity-list{display:grid;gap:18px}.bar-row{display:grid;grid-template-columns:70px 1fr 30px;align-items:center;gap:10px;font-size:12px;color:#9aa6b7}.bar{height:7px;background:#192432;border-radius:20px;overflow:hidden}.bar i{display:block;height:100%;background:#55d6be;border-radius:20px}.compact-list{display:grid}.alert-row{padding:13px 0;border-bottom:1px solid #192432;display:flex;justify-content:space-between;gap:15px}.alert-row:last-child{border:0}.alert-row b{display:block;font-size:13px;margin:6px 0}.alert-row small{display:block;color:#718096;line-height:1.4;max-width:500px}.actions{display:flex;gap:5px}.actions button{background:#121d29;border:1px solid #233141;color:#8290a3;border-radius:7px;width:31px;height:31px}.actions svg{width:15px}.sev{display:inline-block;text-transform:uppercase;font-size:9px;letter-spacing:.5px;padding:3px 7px;border-radius:5px;background:#202b38;color:#aab5c4}.sev.critical,.sev.high{color:#ff7b87;background:#30171d}.sev.medium{color:#f1c75b;background:#302713}.sev.low{color:#55d6be;background:#102622}
.search{display:flex;align-items:center;gap:8px;border:1px solid #243140;border-radius:8px;background:#0b121b;padding:0 10px;width:350px}.search svg{width:15px;color:#6d7b8d}.search input{border:0;outline:0;background:transparent;color:#fff;padding:10px;width:100%}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;padding:12px 9px;border-bottom:1px solid #192432;white-space:nowrap}th{color:#6f7e91;font-weight:500}td{color:#b9c3d0}
label{display:block;color:#8d9bad;font-size:12px;margin-bottom:14px}input,textarea,select{display:block;width:100%;margin-top:6px;background:#0a1119;border:1px solid #243140;border-radius:8px;color:#e8eef5;padding:10px;outline:none}input:focus,textarea:focus,select:focus{border-color:#397c75}.primary{background:#55d6be;border:0;color:#06110f;font-weight:700;padding:10px 15px;border-radius:8px}.toast{position:fixed;right:25px;top:100px;background:#30171d;border:1px solid #6b2832;padding:12px 15px;border-radius:9px;color:#ffadb5;display:flex;gap:10px;z-index:20}.toast svg{width:17px}
.incident,.rule{border-bottom:1px solid #192432;padding:15px 0;display:flex;justify-content:space-between;gap:20px}.incident:last-child,.rule:last-child{border:0}.incident b,.rule b{margin-left:8px;font-size:13px}.incident p,.rule p{color:#748196;font-size:12px;margin:7px 0 0}.status,.enabled,.disabled{font-size:10px;text-transform:uppercase;color:#55d6be}.disabled{color:#8792a1}.rule code{color:#8aa2c1;font-size:11px}.login-page{min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 50% 0%,#122132 0,#080d14 45%)}.login-card{width:390px;background:#0e1621;border:1px solid #243140;border-radius:14px;padding:30px;box-shadow:0 20px 70px #0008}.login-card .brand{margin-bottom:28px}.login-card .primary{width:100%;margin-top:4px}.login-card small{display:block;text-align:center;color:#637186;margin-top:16px}.error{color:#ff8893;background:#2c151b;border:1px solid #51242b;padding:8px;border-radius:7px;margin-bottom:12px;font-size:12px}
@media(max-width:900px){aside{width:70px;padding:15px 8px}.brand.side div,nav button:not(.active)::after,nav button{font-size:0}nav button svg,.side-bottom button svg{margin:auto}main{margin-left:70px}.cards{grid-template-columns:repeat(2,1fr)}.grid-two{grid-template-columns:1fr}.header-right{display:none}}
/* Advanced SOC Sentinel Dashboard */

.advanced-overview {
  display: grid;
  gap: 18px;
}

.overview-welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 22px;
  border: 1px solid #1c2734;
  border-radius: 12px;
  background: linear-gradient(115deg, #142536, #0e1621 70%);
}

.overview-welcome h3 {
  font-size: 22px;
  margin: 8px 0;
  color: #edf4fb;
}

.overview-welcome p {
  margin: 0;
  color: #8493a7;
  font-size: 13px;
  line-height: 1.6;
}

.eyebrow {
  font-size: 10px;
  letter-spacing: 1.5px;
  color: #55d6be;
  font-weight: 700;
}

.overview-live {
  display: flex;
  align-items: center;
  white-space: nowrap;
  border: 1px solid #234b48;
  background: #10231f;
  color: #55d6be;
  border-radius: 999px;
  padding: 9px 12px;
  font-size: 11px;
}

.overview-live .dot {
  margin-right: 7px;
}

.advanced-grid {
  margin-top: 0;
}

.advanced-overview .panel-head > div {
  display: grid;
  gap: 5px;
}

.advanced-overview .panel-head > div > span {
  font-size: 11px;
  color: #718096;
}

.analytics-tag {
  font-size: 10px !important;
  letter-spacing: 0.6px;
  color: #55d6be !important;
  border: 1px solid #234b48;
  background: #10231f;
  padding: 5px 8px;
  border-radius: 6px;
  white-space: nowrap;
}

.advanced-severity-list {
  gap: 20px;
  padding: 8px 0;
}

.advanced-severity-list .bar {
  height: 9px;
}

.advanced-severity-list .bar i {
  transition: width 0.35s ease;
}

.advanced-severity-list .severity-critical .bar i {
  background: #ff6675;
}

.advanced-severity-list .severity-high .bar i {
  background: #f39a68;
}

.advanced-severity-list .severity-medium .bar i {
  background: #e8c35a;
}

.advanced-severity-list .severity-low .bar i {
  background: #55d6be;
}

.analytics-footnote {
  border-top: 1px solid #192432;
  padding-top: 12px;
  margin-top: 8px;
  color: #718096;
  font-size: 11px;
}

.alert-workflow-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin: 10px 0 18px;
}

.workflow-stat {
  padding: 14px;
  border: 1px solid #223041;
  border-radius: 9px;
  background: #0b121b;
  display: grid;
  gap: 8px;
}

.workflow-stat span {
  font-size: 11px;
  color: #8391a4;
}

.workflow-stat strong {
  font-size: 25px;
  color: #edf4fb;
}

.workflow-open {
  border-top: 2px solid #ff6675;
}

.workflow-ack {
  border-top: 2px solid #e8c35a;
}

.workflow-closed {
  border-top: 2px solid #55d6be;
}

.workflow-note {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 12px;
  border-radius: 8px;
  background: #111d29;
  color: #8292a7;
  font-size: 11px;
  line-height: 1.5;
}

.workflow-note svg {
  flex-shrink: 0;
  color: #55d6be;
}

.recent-alerts-panel {
  margin-top: 0;
}

.dashboard-empty {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 24px 8px;
  color: #55d6be;
}

.dashboard-empty div {
  display: grid;
  gap: 4px;
}

.dashboard-empty b {
  font-size: 13px;
  color: #dce5ef;
}

.dashboard-empty span {
  font-size: 12px;
  color: #718096;
}

@media (max-width: 900px) {
  .overview-welcome {
    align-items: flex-start;
    flex-direction: column;
  }

  .overview-live {
    white-space: normal;
  }

  .alert-workflow-stats {
    grid-template-columns: 1fr;
  }

  .advanced-overview .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .advanced-overview .cards {
    grid-template-columns: 1fr;
  }

  .overview-welcome {
    padding: 16px;
  }

  .advanced-overview .panel {
    padding: 15px;
  }
}
/* ===== SOC SENTINEL ADVANCED DASHBOARD ===== */

.advanced-overview {
  display: grid;
  gap: 20px;
}

.overview-welcome {
  background: linear-gradient(120deg, #102b3a, #0e1621 75%);
  border: 1px solid #24505b;
  border-radius: 14px;
  padding: 26px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  box-shadow: 0 8px 35px #0003;
}

.overview-welcome h3 {
  font-size: 26px;
  margin: 10px 0;
  color: #f4f8ff;
}

.overview-welcome p {
  color: #91a5ba;
  font-size: 13px;
  line-height: 1.7;
  margin: 0;
}

.eyebrow {
  color: #55d6be;
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 800;
}

.overview-live {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border: 1px solid #286457;
  background: #102923;
  color: #55d6be;
  border-radius: 30px;
  font-size: 12px;
  white-space: nowrap;
}

.advanced-overview .metric {
  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  background: linear-gradient(145deg, #111e2c, #0b121b);
  box-shadow: 0 5px 20px #0002;
}

.advanced-overview .metric:hover {
  transform: translateY(-4px);
  border-color: #3b8279;
  box-shadow: 0 8px 26px #55d6be12;
}

.advanced-overview .metric-icon {
  width: 48px;
  height: 48px;
  border-radius: 13px;
  background: #12313b;
}

.advanced-overview .metric strong {
  color: #f2f7ff;
  font-size: 30px;
}

.advanced-grid {
  margin-top: 0;
}

.advanced-overview .panel {
  box-shadow: 0 6px 24px #0002;
  transition: border-color .2s ease;
}

.advanced-overview .panel:hover {
  border-color: #2a414f;
}

.advanced-overview .panel-head {
  gap: 12px;
}

.advanced-overview .panel-head h3 {
  color: #edf4ff;
  font-size: 16px;
}

.advanced-overview .panel-head > div > span {
  color: #8194aa;
  font-size: 11px;
}

.analytics-tag {
  color: #55d6be !important;
  background: #102923;
  border: 1px solid #24564c;
  border-radius: 7px;
  padding: 6px 9px;
  font-size: 10px !important;
  letter-spacing: 1px;
}

.advanced-severity-list {
  gap: 22px;
  padding: 10px 0;
}

.advanced-severity-list .bar {
  height: 9px;
  background: #1a2939;
}

.advanced-severity-list .bar i {
  transition: width .5s ease;
}

.advanced-severity-list .severity-critical .bar i {
  background: #ff5369;
}

.advanced-severity-list .severity-high .bar i {
  background: #ff8c62;
}

.advanced-severity-list .severity-medium .bar i {
  background: #f0c35c;
}

.advanced-severity-list .severity-low .bar i {
  background: #25d6bd;
}

.analytics-footnote {
  border-top: 1px solid #1c2b39;
  padding-top: 14px;
  margin-top: 10px;
  color: #8192a7;
  font-size: 11px;
  line-height: 1.6;
}

.alert-workflow-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin: 12px 0 20px;
}

.workflow-stat {
  padding: 16px 12px;
  border: 1px solid #243444;
  border-radius: 10px;
  background: linear-gradient(145deg, #101c29, #0b121b);
  display: grid;
  gap: 10px;
}

.workflow-stat span {
  color: #92a2b6;
  font-size: 11px;
}

.workflow-stat strong {
  font-size: 27px;
  color: #f4f8ff;
}

.workflow-open {
  border-top: 2px solid #ff6577;
}

.workflow-ack {
  border-top: 2px solid #efc15b;
}

.workflow-closed {
  border-top: 2px solid #55d6be;
}

.workflow-note {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 14px;
  border: 1px solid #223543;
  background: #101d29;
  border-radius: 9px;
  color: #9aabc0;
  font-size: 11px;
  line-height: 1.7;
}

.workflow-note svg {
  color: #55d6be;
  flex-shrink: 0;
}

.recent-alerts-panel {
  margin-top: 0;
}

.recent-alerts-panel .alert-row {
  padding: 16px 0;
  transition: background .2s ease;
}

.recent-alerts-panel .alert-row:hover {
  background: #121e2b;
}

.dashboard-empty {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 25px 8px;
  color: #55d6be;
}

.dashboard-empty div {
  display: grid;
  gap: 5px;
}

.dashboard-empty b {
  color: #e7edf5;
  font-size: 13px;
}

.dashboard-empty span {
  color: #8192a7;
  font-size: 12px;
}

@media (max-width: 900px) {
  .overview-welcome {
    align-items: flex-start;
    flex-direction: column;
  }

  .advanced-overview .grid-two {
    grid-template-columns: 1fr;
  }

  .alert-workflow-stats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .overview-welcome {
    padding: 18px;
  }

  .overview-welcome h3 {
    font-size: 21px;
  }

  .alert-workflow-stats {
    grid-template-columns: 1fr;
  }

  .advanced-overview .cards {
    grid-template-columns: 1fr;
  }
}

/* SOC Sentinel Advanced Dashboard */
.advanced-overview {
  max-width: 1600px;
  margin: 0 auto;
  animation: dashboardFade 0.35s ease;
}

@keyframes dashboardFade {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.overview-welcome {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  padding: 30px;
  margin-bottom: 22px;
  border: 1px solid #24505a;
  border-radius: 18px;
  background:
    radial-gradient(circle at 85% 10%, #16454c88, transparent 38%),
    linear-gradient(120deg, #102a38, #0e1621 72%);
  box-shadow: 0 12px 40px #0002;
}

.eyebrow {
  color: #55d6be;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.overview-welcome h3 {
  margin: 14px 0 10px;
  font-size: clamp(23px, 3vw, 32px);
  color: #f4f8ff;
}

.overview-welcome p {
  color: #91a9c3;
  line-height: 1.7;
  margin-bottom: 0;
}

.overview-live {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  padding: 12px 17px;
  border: 1px solid #28645b;
  border-radius: 30px;
  color: #55d6be;
  background: #102b28;
  font-size: 12px;
}

.advanced-overview .cards {
  gap: 18px;
}

.advanced-overview .metric {
  min-height: 116px;
  padding: 23px;
  border-radius: 15px;
  background: linear-gradient(145deg, #111d2a, #0b121b);
  transition: transform 0.2s, border-color 0.2s;
}

.advanced-overview .metric:hover {
  transform: translateY(-4px);
  border-color: #386b70;
}

.advanced-overview .metric-icon {
  width: 50px;
  height: 50px;
  border-radius: 14px;
  background: #123238;
}

.advanced-overview .metric strong {
  font-size: 31px;
  color: #f3f7ff;
}

.advanced-grid {
  gap: 20px;
  margin-top: 22px;
}

.advanced-overview .panel {
  border-radius: 15px;
  padding: 23px;
  box-shadow: 0 8px 30px #0001;
}

.advanced-overview .panel-head {
  gap: 12px;
}

.advanced-overview .panel-head h3 {
  font-size: 16px;
  color: #edf4ff;
}

.advanced-overview .panel-head span {
  display: inline-block;
  margin-top: 5px;
}

.analytics-tag {
  padding: 8px 11px;
  border: 1px solid #24584f;
  border-radius: 8px;
  color: #55d6be !important;
  background: #102622;
  font-size: 10px !important;
  letter-spacing: 0.8px;
}

.advanced-severity-list {
  gap: 23px;
  padding: 15px 0;
}

.advanced-severity-list .bar-row {
  grid-template-columns: 82px minmax(30px, 1fr) 28px;
  gap: 12px;
}

.advanced-severity-list .bar {
  height: 9px;
  background: #1b2a3a;
  border-radius: 20px;
}

.advanced-severity-list .bar i {
  background: linear-gradient(90deg, #2da99b, #55d6be);
  transition: width 0.5s ease;
}

.advanced-severity-list .severity-critical .bar i,
.advanced-severity-list .severity-high .bar i {
  background: linear-gradient(90deg, #f04459, #ff8590);
}

.advanced-severity-list .severity-medium .bar i {
  background: linear-gradient(90deg, #d59c32, #f1ce69);
}

.analytics-footnote {
  border-top: 1px solid #1d2b3a;
  padding-top: 16px;
  color: #8198b4;
  font-size: 12px;
}

.alert-workflow-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 20px;
}

.workflow-stat {
  padding: 17px 14px;
  border: 1px solid #263747;
  border-top: 2px solid #ff6675;
  border-radius: 12px;
  background: linear-gradient(145deg, #111c29, #0b121b);
}

.workflow-stat span {
  display: block;
  color: #8ea3bc;
  font-size: 12px;
}

.workflow-stat strong {
  display: block;
  margin-top: 12px;
  font-size: 28px;
  color: #f4f7fc;
}

.workflow-ack {
  border-top-color: #f1c75b;
}

.workflow-closed {
  border-top-color: #55d6be;
}

.workflow-note {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 22px;
  padding: 15px;
  border: 1px solid #233747;
  border-radius: 11px;
  background: #101d29;
  color: #91a9c3;
  font-size: 12px;
  line-height: 1.7;
}

.workflow-note svg {
  flex-shrink: 0;
  color: #55d6be;
}

.recent-alerts-panel {
  margin-top: 22px;
}

.recent-alerts-panel .alert-row {
  padding: 17px 0;
}

.recent-alerts-panel .alert-row b {
  color: #e8eef8;
}

.recent-alerts-panel .alert-row small {
  margin-top: 7px;
}

.dashboard-empty {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 25px 5px;
  color: #55d6be;
}

.dashboard-empty b,
.dashboard-empty span {
  display: block;
}

.dashboard-empty span {
  margin-top: 6px;
  color: #8193a9;
  font-size: 12px;
}

@media (max-width: 1100px) {
  .advanced-overview .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 650px) {
  .overview-welcome {
    align-items: flex-start;
    flex-direction: column;
    padding: 22px;
  }

  .advanced-overview .cards {
    grid-template-columns: 1fr;
  }

  .alert-workflow-stats {
    grid-template-columns: 1fr;
  }

  .advanced-overview .panel {
    padding: 16px;
  }
}
